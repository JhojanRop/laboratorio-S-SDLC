# Copia este archivo a .env.docker y cambia SECRET_KEY antes de ejecutar Docker.
# Puedes generar una clave con: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=production
SECRET_KEY=cambiar-esta-clave-en-produccion
DATABASE_URI=sqlite:////data/academia_segura.db
UPLOAD_FOLDER=/app/uploads_seguras
PORT=5000
FLASK_DEBUG=false
